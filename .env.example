# Copy to .env and fill in. Paper mode needs no credentials at all.
KALSHI_ENV=demo                       # demo = fake money (demo-api.kalshi.co), prod = real money
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/kalshi_private_key.pem

# Any Config field can be overridden as BOT_<FIELD>. Common ones (defaults shown):
# BOT_EXECUTION=taker                 # live style: taker or maker (paper always runs both)
# BOT_MIN_NET_EDGE=0.04               # required edge per contract after fees ($)
# BOT_CONTRACTS=10                    # cap on contracts per trade
# BOT_RISK_PER_TRADE_PCT=0.005        # max cost of a trade as a fraction of bankroll
# BOT_DAILY_LOSS_PCT=0.02             # stop for the day after losing this fraction
# BOT_MAX_CONSECUTIVE_LOSSES=3
# BOT_PAPER_BANKROLL=1000
# BOT_PAPER_LATENCY_S=2.0
